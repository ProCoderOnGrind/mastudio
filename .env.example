# TinaCMS Cloud credentials — required for the HOSTED admin + auto-deploy.
# Leave these UNSET locally to keep using the open local admin (`pnpm dev`).
# Get the values from https://app.tina.io after creating a project for this repo.

# Public client id of your Tina Cloud project (safe to expose; ships in the admin bundle).
NEXT_PUBLIC_TINA_CLIENT_ID=

# Read-only content token from your Tina Cloud project (SECRET — never commit a filled-in .env).
TINA_TOKEN=

# Branch Tina Cloud reads/writes. Optional: on Vercel it falls back to the deployed
# branch automatically; locally it falls back to "master".
# NEXT_PUBLIC_TINA_BRANCH=master
